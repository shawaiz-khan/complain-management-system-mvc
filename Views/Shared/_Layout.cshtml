<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Complaint Management System</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    @if (ViewBag.HideNav != true)
    {
        <header>
            <nav class="navbar">
                <div class="nav-container">
                    <a class="nav-brand" asp-controller="Home" asp-action="Index">Complaint Management System</a>
                    <div class="nav-links">
                        @if ((string)ViewBag.Role == "admin")
                        {
                            <a asp-controller="Admin" asp-action="Index">Dashboard</a>
                        }
                        else if ((string)ViewBag.Role == "auditor")
                        {
                            <a asp-controller="Auditor" asp-action="Index">Dashboard</a>
                        }
                        else
                        {
                            <a asp-controller="Home" asp-action="Index">Dashboard</a>
                            <a asp-controller="Home" asp-action="Create">Submit Complaint</a>
                        }
                        <a asp-controller="Auth" asp-action="Logout" style="color: #ef4444;">Logout</a>
                        @if (ViewBag.UserName != null)
                        {
                            <span class="nav-role" style="margin-left: 1.5rem;">
                                @ViewBag.UserName &middot;
                                @{
                                    var r = (string)ViewBag.Role ?? "user";
                                    @(char.ToUpper(r[0]) + r.Substring(1))
                                }
                            </span>
                        }
                    </div>
                </div>
            </nav>
        </header>
    }
    <div class="main-container">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="footer">
        <div class="footer-container">
            &copy; 2026 - Complaint Management System
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
